{
  "name": "human-in-the-loop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fixtures": "node tools/lintFixtures.ts",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dup": "jscpd",
    "knip": "knip",
    "size": "size-limit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run lint:fixtures && npm run lint:css && npm run format:check && npm run dup && npm run knip && npm run build && npm run size && npm test",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "dependencies": {
    "@preact/signals": "~2.11.4",
    "fflate": "~0.8.3",
    "idb": "~8.0.4",
    "intl-messageformat": "~12.1.4",
    "pdfkit": "~0.20.2",
    "preact": "~10.29.8",
    "pure-rand": "~8.4.2",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "~4.8.1",
    "@playwright/test": "~1.64.1",
    "@preact/preset-vite": "~2.10.6",
    "@size-limit/preset-app": "~14.3.0",
    "@testing-library/preact": "~3.2.6",
    "@types/node": "~24.19.2",
    "eslint": "~10.13.0",
    "eslint-import-resolver-typescript": "~4.4.5",
    "eslint-plugin-boundaries": "~7.3.0",
    "eslint-plugin-sonarjs": "~4.2.2",
    "fast-check": "~4.10.2",
    "happy-dom": "~21.0.4",
    "jscpd": "~5.4.2",
    "knip": "~6.43.0",
    "lint-staged": "~17.6.0",
    "prettier": "~3.9.10",
    "simple-git-hooks": "~2.14.0",
    "size-limit": "~14.3.0",
    "stylelint": "~17.16.0",
    "stylelint-config-standard": "~40.0.0",
    "stylelint-declaration-strict-value": "~1.12.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vite": "~8.3.5",
    "vite-plugin-pwa": "~2.0.0",
    "vitest": "~5.0.5",
    "yaml": "~2.9.1"
  }
}
